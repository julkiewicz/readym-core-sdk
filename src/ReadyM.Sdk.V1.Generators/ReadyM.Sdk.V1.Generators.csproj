<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <!-- v1 SDK layer: the generators that target the v1 RPC base classes (ClientRpcHandler,
             ServerRpcClient, ServerRpcHandlersBase). Moved out of ReadyM.Api.Generators; the namespace is kept. -->
        <RootNamespace>ReadyM.Api.Generators</RootNamespace>
        <ReadyMLayer>V1</ReadyMLayer>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
        <!-- Analysis-time only: the compiler host provides these, so they must not flow to consumers. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Helpers shared with the core generators, compiled into this assembly as linked sources: an
             analyzer cannot take a project reference to another analyzer without shipping it alongside. -->
        <Compile Include="..\ReadyM.Api.Generators\SerializationHelper.cs" Link="Shared\SerializationHelper.cs" />
        <Compile Include="..\ReadyM.Api.Generators\ServerRpcModel.cs" Link="Shared\ServerRpcModel.cs" />
        <Compile Include="..\ReadyM.Api.Generators\Compat\NotNullAttribute.cs" Link="Shared\Compat\NotNullAttribute.cs" />
        <Compile Include="..\ReadyM.Api.Generators\Compat\NotNullWhenAttribute.cs" Link="Shared\Compat\NotNullWhenAttribute.cs" />
    </ItemGroup>
</Project>
